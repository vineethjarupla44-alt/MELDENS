# =============================================================================
# MedLens Environment Configuration Template
# Placeholders only — NEVER commit real credentials to version control!
# =============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=true

# Database Connection (Default: Local SQLite)
DATABASE_URL=sqlite:///./medlens.db

# Medical Document Storage Path
UPLOAD_DIR=./uploads

# Google Gemini AI API Configuration
# (Optional: MedLens includes deterministic clinical extractors and validators if unset)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-pro

# CORS Allowed Origins (Comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
