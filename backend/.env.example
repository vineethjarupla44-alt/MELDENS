# MedLens Backend Configuration
PROJECT_NAME="MedLens — AI-Powered Clinical Information Intelligence"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# CORS - Allowed Frontend Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database - SQLite for zero-friction local development, PostgreSQL ready
DATABASE_URL="sqlite:///./medlens.db"

# Storage
UPLOAD_DIR="./uploads"

# AI Service Configuration (Phase 2)
GEMINI_API_KEY=""
LLM_MODEL="gemini-1.5-pro"
